# COMMON
APP_NAME=weaver2
PORT=4000
NODE_ENV=development
ORIGIN_URL=localhost:4000
CLIENT_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:4000,http://localhost:3000

# DATABASE
# Prisma connection pool params (optional, append as URL query):
#   ?connection_limit=10&pool_timeout=20
# Defaults: connection_limit = num_physical_cpus * 2 + 1, pool_timeout = 10s
# For heavy production workloads, prefer PgBouncer (transaction pooling) instead.
# 기본값은 docker-compose의 db 서비스와 일치한다 (docker-compose up -d db 후 그대로 사용 가능).
# 별도 PostgreSQL을 쓴다면 접속 정보에 맞게 수정할 것.
DATABASE_URL=postgresql://weaver:weaver1234@localhost:5432/weaver2

# Docker (used by docker-compose)
DOCKER_APP_TARGET=core          # target app to build (e.g., core, admin)
DB_USER=weaver
DB_PASSWORD=weaver1234
DB_NAME=weaver2
DB_PORT=5432

# TOKEN
# 필수 — 미설정 시 인증이 동작하지 않는다.
# 임의의 긴 랜덤 문자열: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=15m
# CSRF (csrf-csrf double-submit) — 미설정 시 JWT_SECRET을 fallback으로 사용
CSRF_SECRET=
# TOTP 2FA secret 암호화 키 (AES-256-GCM). 미설정 시 2FA 설정/인증 시점에 실패한다.
# 임의의 긴 랜덤 문자열: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOTP_ENCRYPTION_KEY=

# EMAIL
# 미설정 시 서버는 정상 부팅되며 이메일 발송만 비활성화된다 (경고 로그).
# 회원가입 이메일 인증·비밀번호 재설정 등 메일 의존 기능을 쓰려면 반드시 설정할 것.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Locale and Timezone
APP_LOCALE=ko-KR
APP_TIMEZONE=Asia/Seoul

# Permission Cache
PERMISSION_CACHE_STRATEGY=memory  # memory | none
PERMISSION_CACHE_TTL=300          # seconds
PERMISSION_CACHE_MAX_SIZE=1000    # max cached users

# OAuth - Common
OAUTH_SUCCESS_REDIRECT_URL=http://localhost:3000
OAUTH_FAILURE_REDIRECT_URL=http://localhost:3000/login?error=oauth_failed

# OAuth - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/google/callback

# OAuth - Kakao
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/kakao/callback

# OAuth - Naver
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/naver/callback

# Web Push (VAPID)
# Generate keys: node -e "const wp=require('web-push'); console.log(wp.generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
