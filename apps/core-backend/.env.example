# COMMON
APP_NAME=weaver2
PORT=4000
# 🔴 이 값은 **로컬 개발용**이다. 프로덕션 배포는 이 파일이 아니라 배포 경로가
#    NODE_ENV=production 을 세운다 (scripts/setup.sh·auto-deploy.sh 의 PM2,
#    docker-compose.prod 의 environment). 이 파일을 프로덕션 서버에 그대로 복사해
#    두면 쿠키 secure·CSRF __Host-·스로틀이 꺼지므로, 프로덕션 .env 에서는
#    NODE_ENV 를 production 으로 두거나 배포 경로가 덮게 한다.
NODE_ENV=development
# 무차별 대입 방어(스로틀)를 끄려면 아래를 true 로. 🔴 프로덕션에는 두지 말 것.
# 미설정 = 스로틀 켜짐. (개발 편의로만 켠다)
# THROTTLE_DISABLED=true
# Swagger(/docs)가 떠 있는 백엔드 자신의 host:port (스킴까지 적어도 된다: https://api.example.com).
# 이 origin 에서 온 요청·이 origin 의 /docs Referer 만 CSRF 검사에서 면제한다. 비우면 면제 없음.
ORIGIN_URL=localhost:4000
# req.ip 를 X-Forwarded-For 에서 읽을 때 믿을 프록시 (express 'trust proxy').
# 미설정 = loopback (같은 호스트의 Next.js rewrite·nginx 만 믿는다). 스로틀 버킷·로그인 IP 기록이 이 값을 따른다.
# 프록시가 다른 호스트면 그 주소/대역을 쉼표로 (예: loopback,10.0.0.0/8), 홉 수(예: 1), 끄려면 false.
# 🔴 true 는 클라이언트가 보낸 XFF 를 통째로 믿는다 — 쓰지 말 것.
# 🔴 앞단 nginx 는 XFF 를 $remote_addr 로 덮어써야 한다 (Next 는 XFF 가 있으면 그대로 넘긴다 — scripts/setup.sh 참고).
# Docker(docker-compose.prod.yml)에서는 앞단 프록시가 loopback 이 아니라 브리지 게이트웨이(172.x)로
#   들어온다 — 기본값이면 다시 한 통 버킷이 된다. 그 대역을 적는다: TRUST_PROXY=loopback,172.16.0.0/12
# 홉 수는 1~3 만 받는다(0 · 빈 목록 · 큰 수는 부팅에서 거절). 부팅 로그에 결정된 값이 찍힌다.
# TRUST_PROXY=loopback
CLIENT_URL=http://localhost:3000
# 뒤쪽 3010~3019 · 4010~4019 는 병렬 레인 대역이다 (scripts/lane.sh 의 FRONTEND_PORT_RANGE · BACKEND_PORT_RANGE).
# 레인마다 고치지 않도록 한 번 열어 둔다 — 프록시를 거쳐도 브라우저의 Origin 은
# 백엔드까지 그대로 가므로, 목록에 없으면 그 레인은 로그인부터 막힌다.
# 4010~4019 는 백엔드가 직접 서빙하는 관리자 뷰(/admin)의 Origin 이다 — 레인 백엔드 포트에서 열면 그 포트가 Origin 이 된다.
ALLOWED_ORIGINS=http://localhost:4000,http://localhost:3000,http://localhost:3010,http://localhost:3011,http://localhost:3012,http://localhost:3013,http://localhost:3014,http://localhost:3015,http://localhost:3016,http://localhost:3017,http://localhost:3018,http://localhost:3019,http://localhost:4010,http://localhost:4011,http://localhost:4012,http://localhost:4013,http://localhost:4014,http://localhost:4015,http://localhost:4016,http://localhost:4017,http://localhost:4018,http://localhost:4019

# DATABASE
# Prisma 7 은 드라이버 어댑터(@prisma/adapter-pg = node-pg 풀)로 붙는다.
# URL 의 ?connection_limit=·pool_timeout=·connect_timeout= 은 더 이상 읽히지 않는다 — 붙이지 말 것.
# 풀 크기는 DATABASE_POOL_MAX 로 정한다 (기본 10). 접속 대기 5s·유휴 300s 는 PrismaService 에 고정.
# For heavy production workloads, prefer PgBouncer (transaction pooling) instead.
# 기본값은 docker-compose의 db 서비스와 일치한다 (docker-compose up -d db 후 그대로 사용 가능).
# 별도 PostgreSQL을 쓴다면 접속 정보에 맞게 수정할 것.
DATABASE_URL=postgresql://weaver:weaver1234@localhost:5432/weaver2
# DATABASE_POOL_MAX=10

# Docker (used by docker-compose)
DOCKER_APP_TARGET=core          # target app to build (e.g., core, admin)
DB_USER=weaver
DB_PASSWORD=weaver1234
DB_NAME=weaver2
DB_PORT=5432

# TOKEN
# 필수 — 미설정 시 인증이 동작하지 않는다.
# 임의의 긴 랜덤 문자열: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=15m
# CSRF (csrf-csrf double-submit) — 미설정 시 JWT_SECRET을 fallback으로 사용
CSRF_SECRET=
# TOTP 2FA secret 암호화 키 (AES-256-GCM). 미설정 시 2FA 설정/인증 시점에 실패한다.
# 임의의 긴 랜덤 문자열: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOTP_ENCRYPTION_KEY=
# 인증 앱(Google Authenticator 등)에 보이는 발급자 이름 — 파생 프로젝트는 서비스 이름으로 (비우면 Weaver2)
TOTP_ISSUER=

# FILES
# 파일 주소(FileDto.url·profileImageUrl)의 앞부분 — 주소는 `${FILE_URL_BASE}/v1/files/:id` 가 된다.
# 기본 /api 는 Next 리라이트를 거치는 같은 출처 주소라 쿠키가 따라가 회원 전용 첨부도 <img> 로 보인다.
# 프런트가 API 를 직접 부르면(리라이트 없이) 그 주소로 바꾼다. 받을 때마다 권한을 본다(정적 /uploads 는 없다).
# FILE_URL_BASE=/api

# EMAIL
# 미설정 시 서버는 정상 부팅되며 이메일 발송만 비활성화된다 (경고 로그).
# 회원가입 이메일 인증·비밀번호 재설정 등 메일 의존 기능을 쓰려면 반드시 설정할 것.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Locale and Timezone
APP_LOCALE=ko-KR
APP_TIMEZONE=Asia/Seoul

# Permission Cache
PERMISSION_CACHE_STRATEGY=memory  # memory | none
PERMISSION_CACHE_TTL=300          # seconds
PERMISSION_CACHE_MAX_SIZE=1000    # max cached users

# 로그인 방식 — local(기본) | sso. sso 면 비밀번호 · 가입 · 재설정 · 2FA · OAuth 경로가 404 로 닫히고
# 로그인을 바깥 OIDC 발급자에 맡긴다 (docs/handbook/11-sso.md). sso 인데 아래 필수 셋이 비면 부팅이 멈춘다.
# OIDC_* 는 공급자(oidc-provider) 쪽 이름이다 — 손님은 ACCOUNTS_OIDC_*
AUTH_MODE=local
ACCOUNTS_OIDC_ISSUER=
ACCOUNTS_OIDC_CLIENT_ID=
ACCOUNTS_OIDC_CLIENT_SECRET=
# 비우면 CLIENT_URL 에서 나온다: ${CLIENT_URL}/api/v1/auth/oidc/callback · ${CLIENT_URL}/
ACCOUNTS_OIDC_REDIRECT_URI=
ACCOUNTS_OIDC_POST_LOGOUT_REDIRECT_URI=
# 계정 서버의 계정 화면 (예: https://accounts.rlidea.com/account). 보안 화면은 그 아래 /security —
# 보안 설정 화면의 「계정 서버에서 관리하기」가 새 탭으로 연다 (없으면 링크를 그리지 않는다)
ACCOUNTS_OIDC_ACCOUNT_URL=
# start 의 lang 으로 받을 값 (첫 값이 기본)
ACCOUNTS_OIDC_LANGS=ko
# 입구별 실패 주소 — 입구=경로,… 또는 JSON. 경로에 {lang} 을 쓸 수 있다
ACCOUNTS_OIDC_FAILURE_URLS=admin=/login
ACCOUNTS_OIDC_DEFAULT_NEXT=/dashboard
# back-channel 로그아웃 — 발급자 등록의 backchannel_logout_session_required 와 같게(true 면 sid 없는 logout_token 은 400).
# 발급자에 등록할 주소: ${CLIENT_URL}/api/v1/auth/oidc/backchannel-logout (백엔드 경로 /v1/auth/oidc/backchannel-logout)
ACCOUNTS_OIDC_BACKCHANNEL_SESSION_REQUIRED=true

# OAuth - Common
OAUTH_SUCCESS_REDIRECT_URL=http://localhost:3000
OAUTH_FAILURE_REDIRECT_URL=http://localhost:3000/login?error=oauth_failed
# OAuth 로그인한 사람에게 2단계 인증이 켜져 있으면 여기로 보낸다 — 화면이 /v1/auth/2fa/pending 으로 수단을 묻는다
OAUTH_TWO_FACTOR_REDIRECT_URL=http://localhost:3000/login?step=2fa

# OAuth - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/google/callback

# OAuth - Kakao
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/kakao/callback

# OAuth - Naver
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/naver/callback

# OAuth - Apple (기본 꺼짐 — Apple Developer 멤버십이 있어야 Services ID·키를 만들 수 있다)
# 콜백은 appleid.apple.com 이 form 을 POST 로 보낸다. return URL 에 localhost·IP 는 등록할 수 없어
# 개발 시험에도 HTTPS 도메인(터널)이 필요하다.
APPLE_OAUTH_ENABLED=false
# Services ID (예: com.example.web)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# 개인키(.p8)는 둘 중 하나로 준다. 여러 줄 PEM 은 .env·pm2·CI 에서 줄바꿈이 깨지기 쉬워 경로를 권한다.
# 한 줄로 넣을 때는 APPLE_PRIVATE_KEY 의 줄바꿈을 \n 으로 적는다.
APPLE_PRIVATE_KEY_PATH=
APPLE_PRIVATE_KEY=
APPLE_CALLBACK_URL=https://your-domain.example/api/v1/auth/oauth/apple/callback

# Web Push (VAPID)
# Generate keys: node -e "const wp=require('web-push'); console.log(wp.generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
