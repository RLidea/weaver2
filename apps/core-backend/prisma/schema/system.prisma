// =============================================================================
// Framework: System Settings & Analytics
// =============================================================================

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model PageView {
  id        String   @id @default(uuid())
  pageUrl   String   @db.VarChar(500)
  userId    String?
  ipAddress String?  @db.VarChar(45)
  referrer  String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([pageUrl, createdAt])
  @@index([userId, createdAt])
  @@map("page_views")
}

// JSON 컬럼은 "이미 가공된 스냅샷 보고서"용으로만 사용한다.
// MonthlyAnalyticsReport·SecurityAuditReport는 한 시점에 집계된 결과를
// 그대로 보여주는 read-only 표시 용도이므로 JSON이 합리적이다.
// 향후 다음 요건이 생기면 별도 정규화 테이블로 분리한다:
//   - JSON 내부 필드를 인덱스로 검색해야 함
//   - JSON 내부 값으로 집계(GROUP BY/SUM)해야 함
//   - 시간에 따른 trend를 단일 row 단위로 비교해야 함
model MonthlyAnalyticsReport {
  id             String   @id @default(uuid())
  year           Int
  month          Int
  totalPageViews Int      @default(0)
  uniqueVisitors Int      @default(0)
  dailyAvgViews  Float    @default(0)
  peakDailyViews Int      @default(0)
  topPages       Json?
  trafficSources Json?
  dailyTrends    Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([year, month])
  @@map("monthly_analytics_reports")
}

model SecurityAuditReport {
  id                 String   @id @default(uuid())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  scanType           String   @default("pnpm_audit")
  scanDuration       Int?
  totalDependencies  Int
  vulnerabilityCount Json
  securityScore      Int
  rawAuditData       Json
  vulnerabilities    Json
  recommendations    Json?
  packageJsonHash    String?
  lockfileHash       String?

  @@map("security_audit_reports")
}
