// =============================================================================
// Project: Board Feature
// =============================================================================

model Board {
  id            String         @id @default(uuid())
  name          String         @unique
  description   String?
  /// 켜면 글을 만들고 고칠 때마다 판(PostRevision)을 남긴다
  keepRevisions Boolean        @default(false)
  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  posts         Post[]
  categories    PostCategory[]

  @@map("boards")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Post {
  id          String           @id @default(uuid())
  title       String
  content     String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  boardId     String
  authorId    String
  categoryId  String?
  isPinned    Boolean          @default(false)
  isSecret    Boolean          @default(false)
  priority    Int              @default(0)
  status      PostStatus       @default(PUBLISHED)
  viewCount   Int              @default(0)
  hiddenAt    DateTime?
  deletedAt   DateTime?
  comments    Comment[]
  reactions   PostReaction[]
  attachments PostAttachment[]
  revisions   PostRevision[]
  author      User             @relation(fields: [authorId], references: [id])
  board       Board            @relation(fields: [boardId], references: [id])
  category    PostCategory?    @relation(fields: [categoryId], references: [id])

  @@index([boardId, status, isPinned, priority, viewCount], map: "post_list_idx")
  @@index([createdAt(sort: Desc), id], map: "post_cursor_idx")
  @@index([viewCount(sort: Desc), id], map: "post_viewcount_cursor_idx")
  @@index([authorId, createdAt(sort: Desc)], map: "post_author_idx")
  @@index([categoryId], map: "post_category_idx")
  @@map("posts")
}

/// 글의 판 — 저장한 뒤의 제목 · 본문. 게시판의 keepRevisions 가 켜져 있을 때만 쌓인다
model PostRevision {
  id          String                @id @default(uuid())
  postId      String
  title       String
  content     String
  actorUserId String?
  actorKind   PostRevisionActorKind @default(SESSION)
  createdAt   DateTime              @default(now())
  post        Post                  @relation(fields: [postId], references: [id], onDelete: Cascade)
  actorUser   User?                 @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([postId, createdAt(sort: Desc)], map: "post_revision_post_idx")
  @@map("post_revisions")
}

model Comment {
  id        String    @id @default(uuid())
  content   String
  hiddenAt  DateTime?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  postId    String
  authorId  String
  parentId  String?
  author    User      @relation(fields: [authorId], references: [id])
  post      Post      @relation(fields: [postId], references: [id])
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  children  Comment[] @relation("CommentReplies")

  @@index([postId, parentId, createdAt], map: "comment_list_idx")
  @@index([authorId, createdAt(sort: Desc)], map: "comment_author_idx")
  @@map("comments")
}

model PostCategory {
  id          String   @id @default(uuid())
  name        String
  description String?
  color       String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  boardId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  posts       Post[]
  board       Board    @relation(fields: [boardId], references: [id])

  @@unique([boardId, name])
  @@map("post_categories")
}

model Emoji {
  id        String         @id @default(uuid())
  code      String         @unique
  name      String
  unicode   String?
  imageUrl  String?
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  reactions PostReaction[]

  @@map("emojis")
}

model PostReaction {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  postId    String
  userId    String
  emojiId   String
  post      Post     @relation(fields: [postId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  emoji     Emoji    @relation(fields: [emojiId], references: [id])

  @@unique([postId, userId, emojiId])
  @@index([postId])
  @@index([userId])
  @@map("post_reactions")
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  DELETED
}

/// 판을 남긴 주체가 로그인 세션인지, 범위 토큰인지
enum PostRevisionActorKind {
  SESSION
  TOKEN
}
