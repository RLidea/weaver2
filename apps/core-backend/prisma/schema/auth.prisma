// =============================================================================
// Framework: Authentication & User Core
// =============================================================================

model User {
  id                 String                @id @default(uuid())
  email              String                @unique
  username           String                @unique
  displayName        String                @unique
  // 프로필 이미지는 files 의 한 행 — 주소는 저장하지 않고 /v1/files/:id 로 만든다
  profileImageFileId String?               @unique
  profileImage       File?                 @relation("ProfileImage", fields: [profileImageFileId], references: [id], onDelete: Restrict)
  warningCount       Int                   @default(0)
  suspendedUntil     DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  deletedAt          DateTime?
  lastLoginAt        DateTime?
  // 지금의 email 주인임이 증명된 시각. email 이 바뀌면 다시 정해진다
  emailVerifiedAt    DateTime?
  // 바깥 계정 서버(AUTH_MODE=sso)의 sub. 이 칸으로만 찾는다 — 이메일로 저절로 잇지 않는다.
  // 이미 있는 행은 운영자가 `pnpm sso:link` 로 잇는다. 탈퇴하면 비운다
  ssoSubject         String?               @unique
  localCredential    LocalCredential?
  oauthAccounts      OAuthAccount[]
  refreshTokens      RefreshToken[]
  apiTokens          ApiToken[]            @relation("ApiTokenOwner")
  issuedApiTokens    ApiToken[]            @relation("ApiTokenIssuer")
  revokedApiTokens   ApiToken[]            @relation("ApiTokenRevoker")
  twoFactorMethods   TwoFactorMethod[]
  oneTimeCodes       OneTimeCode[]
  authLockouts       AuthLockout[]
  emailLogs          EmailLog[]
  pageViews          PageView[]
  userSetting        UserSetting?
  userAgreements     UserTermsAgreement[]
  permissionGroups   UserPermissionGroup[]
  notifications      Notification[]
  pushSubscriptions  PushSubscription[]

  // Project-specific relations (board)
  posts         Post[]
  comments      Comment[]
  reactions     PostReaction[]
  uploadedFiles File[]         @relation("FileUploader")
  postRevisions PostRevision[]

  // Project-specific relations (report)
  reportsMade    Report[] @relation("ReportsMade")
  reportsHandled Report[] @relation("ReportsHandled")

  @@map("users")
}

model UserSetting {
  id                          String   @id @default(uuid())
  userId                      String   @unique
  isMarketingConsentGiven     Boolean  @default(false)
  isNewsletterSubscribed      Boolean  @default(false)
  isEmailNotificationsEnabled Boolean  @default(true)
  isSmsNotificationsEnabled   Boolean  @default(false)
  isPushNotificationsEnabled  Boolean  @default(false)
  prefersDarkMode             Boolean  @default(false)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
  user                        User     @relation(fields: [userId], references: [id])

  @@map("user_settings")
}

/// 비밀번호 하나만 안다. 이메일 인증·2FA·잠금·일회용 비밀은 각자의 자리로 갔다.
model LocalCredential {
  userId            String   @id
  passwordHash      String
  passwordChangedAt DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("local_credentials")
}

// 2FA 수단·일회용 비밀·잠금은 사람(User)에 붙는다
// (docs/design/specs/2026-10-17-auth-credential-model-design.md).

enum TwoFactorKind {
  TOTP
  EMAIL
}

/// 사람에 붙는 2차 인증 수단. 로그인 수단(비밀번호·OAuth)과 무관하다.
model TwoFactorMethod {
  id               String        @id @default(uuid())
  userId           String
  kind             TwoFactorKind
  secretEncrypted  String? // TOTP 만 (AES-256-GCM, v1 형식)
  lastUsedTimeStep Int? // TOTP 만 — 이 값 이하의 시간 단위는 거절(재사용 차단)
  confirmedAt      DateTime? // TOTP 만 null 가능 = QR 을 받았지만 코드로 확인 전
  createdAt        DateTime      @default(now())
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
  @@map("two_factor_methods")
}

enum OneTimeCodePurpose {
  EMAIL_VERIFICATION // 링크 — 가입 인증
  PASSWORD_RESET // 링크
  EMAIL_CHANGE // 6자리 — 새 주소로
  TWO_FACTOR_LOGIN // 6자리 — pre-auth 상태에서
  TWO_FACTOR_SETUP // 6자리 — 이메일 2FA 켜기
  STEP_UP // 6자리 — 로그인한 사용자가 민감한 동작(2FA 해제 등) 전에 다시 증명
}

/// 메일로 보내는 일회용 비밀 전부. 쓰면 행을 지운다(소비 = 삭제).
model OneTimeCode {
  id         String             @id @default(uuid())
  userId     String
  purpose    OneTimeCodePurpose
  secretHash String             @unique
  newEmail   String? // EMAIL_CHANGE 만
  attempts   Int                @default(0)
  expiresAt  DateTime
  createdAt  DateTime           @default(now())
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, purpose]) // 목적마다 살아 있는 것은 하나
  @@index([expiresAt]) // 정리 작업용
  @@map("one_time_codes")
}

enum AuthFactor {
  PASSWORD
  SECOND_FACTOR // TOTP·이메일 2FA 코드
}

/// 사람·요소별 추측 실패.
model AuthLockout {
  userId         String
  factor         AuthFactor
  failedAttempts Int        @default(0)
  lockedUntil    DateTime?
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, factor])
  @@map("auth_lockouts")
}

model OAuthAccount {
  id           String    @id @default(uuid())
  provider     String
  providerId   String
  /// 아래 세 칸은 비워 둔다 — 공급자 토큰은 저장하지 않는다 (OAuthService.findOrCreateUser 참조)
  accessToken  String?
  refreshToken String?
  tokenExpiry  DateTime?
  userId       String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@map("oauth_accounts")
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique // SHA-256 해시로 저장 (원문은 쿠키로만 전달)
  expires   DateTime
  rotatedAt DateTime? // 회전(재발급)된 시각. 값이 있으면 무효화된 토큰이며, 재제시 시 탈취 감지에 쓰인다.
  userId    String
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// 사람이 아닌 호출자가 `@ApiTokenScope` 경로 몇 개만 부르는 토큰. 주인의 권한은 따라가지 않는다.
/// 원문(`<prefix>_<random>`)은 발급 때 한 번만 보이고, 여기에는 sha256 해시만 둔다.
model ApiToken {
  id          String    @id @default(uuid())
  userId      String
  name        String
  prefix      String    @unique // 원문의 앞부분 — 조회 열쇠이자 목록에서 알아보는 이름표
  tokenHash   String    @unique // sha256(원문) hex
  scopes      String[]
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime? // 끊은 시각. 되살리지 않는다
  issuedById  String? // 발급한 관리자 — 그 행이 지워져도 토큰은 남는다(SetNull)
  revokedById String? // 끊은 관리자
  createdAt   DateTime  @default(now())
  user        User      @relation("ApiTokenOwner", fields: [userId], references: [id], onDelete: Cascade)
  issuedBy    User?     @relation("ApiTokenIssuer", fields: [issuedById], references: [id], onDelete: SetNull)
  revokedBy   User?     @relation("ApiTokenRevoker", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("api_tokens")
}
