// =============================================================================
// Framework: Authentication & User Core
// =============================================================================

model User {
  id                  String                @id @default(uuid())
  email               String                @unique
  username            String                @unique
  displayName         String                @unique
  profileImageUrl     String?
  profileImagePath    String?
  warningCount        Int                   @default(0)
  suspendedUntil      DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  deletedAt           DateTime?
  lastLoginAt         DateTime?
  // 지금의 email 주인임이 증명된 시각. email 이 바뀌면 다시 정해진다
  emailVerifiedAt     DateTime?
  localCredential     LocalCredential?
  oauthAccounts       OAuthAccount[]
  refreshTokens       RefreshToken[]
  twoFactorMethods    TwoFactorMethod[]
  oneTimeCodes        OneTimeCode[]
  authLockouts        AuthLockout[]
  twoFactorChallenges TwoFactorChallenge[]
  emailChangeRequests EmailChangeRequest[]
  emailLogs           EmailLog[]
  pageViews           PageView[]
  userSetting         UserSetting?
  userAgreements      UserTermsAgreement[]
  permissionGroups    UserPermissionGroup[]
  notifications       Notification[]
  pushSubscriptions   PushSubscription[]

  // Project-specific relations (board)
  posts     Post[]
  comments  Comment[]
  reactions PostReaction[]
  files     PostFile[]

  // Project-specific relations (report)
  reportsMade    Report[] @relation("ReportsMade")
  reportsHandled Report[] @relation("ReportsHandled")

  @@map("users")
}

model UserSetting {
  id                          String   @id @default(uuid())
  userId                      String   @unique
  isMarketingConsentGiven     Boolean  @default(false)
  isNewsletterSubscribed      Boolean  @default(false)
  isEmailNotificationsEnabled Boolean  @default(true)
  isSmsNotificationsEnabled   Boolean  @default(false)
  isPushNotificationsEnabled  Boolean  @default(false)
  prefersDarkMode             Boolean  @default(false)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
  user                        User     @relation(fields: [userId], references: [id])

  @@map("user_settings")
}

model LocalCredential {
  id                      String    @id @default(uuid())
  password                String
  passwordResetToken      String?   @unique
  resetTokenExpiry        DateTime?
  verificationToken       String?   @unique
  verificationTokenExpiry DateTime?
  isVerified              Boolean   @default(false)
  totpEnabled             Boolean   @default(false)
  totpSecret              String?
  emailOtpEnabled         Boolean   @default(false)
  failedAttempts          Int       @default(0)
  lockedUntil             DateTime?
  userId                  String    @unique
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("local_credentials")
}

model TwoFactorChallenge {
  id        String   @id @default(uuid())
  userId    String
  codeHash  String
  method    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, method])
  @@map("two_factor_challenges")
}

model EmailChangeRequest {
  id        String   @id @default(uuid())
  userId    String
  newEmail  String
  codeHash  String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_change_requests")
}

// 아래 세 테이블이 local_credentials 의 2FA·잠금 컬럼과 two_factor_challenges ·
// email_change_requests 를 대신한다 (docs/design/specs/2026-10-17-auth-credential-model-design.md).
// 옛 것은 서비스가 다 옮겨 간 뒤 축소 마이그레이션에서 지운다.

enum TwoFactorKind {
  TOTP
  EMAIL
}

/// 사람에 붙는 2차 인증 수단. 로그인 수단(비밀번호·OAuth)과 무관하다.
model TwoFactorMethod {
  id               String        @id @default(uuid())
  userId           String
  kind             TwoFactorKind
  secretEncrypted  String? // TOTP 만 (AES-256-GCM, v1 형식)
  lastUsedTimeStep Int? // TOTP 만 — 이 값 이하의 시간 단위는 거절(재사용 차단)
  confirmedAt      DateTime? // TOTP 만 null 가능 = QR 을 받았지만 코드로 확인 전
  createdAt        DateTime      @default(now())
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
  @@map("two_factor_methods")
}

enum OneTimeCodePurpose {
  EMAIL_VERIFICATION // 링크 — 가입 인증
  PASSWORD_RESET // 링크
  EMAIL_CHANGE // 6자리 — 새 주소로
  TWO_FACTOR_LOGIN // 6자리 — pre-auth 상태에서
  TWO_FACTOR_SETUP // 6자리 — 이메일 2FA 켜기
  STEP_UP // 6자리 — 로그인한 사용자가 민감한 동작(2FA 해제 등) 전에 다시 증명
}

/// 메일로 보내는 일회용 비밀 전부. 쓰면 행을 지운다(소비 = 삭제).
model OneTimeCode {
  id         String             @id @default(uuid())
  userId     String
  purpose    OneTimeCodePurpose
  secretHash String             @unique
  newEmail   String? // EMAIL_CHANGE 만
  attempts   Int                @default(0)
  expiresAt  DateTime
  createdAt  DateTime           @default(now())
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, purpose]) // 목적마다 살아 있는 것은 하나
  @@index([expiresAt]) // 정리 작업용
  @@map("one_time_codes")
}

enum AuthFactor {
  PASSWORD
  SECOND_FACTOR // TOTP·이메일 2FA 코드
}

/// 사람·요소별 추측 실패.
model AuthLockout {
  userId         String
  factor         AuthFactor
  failedAttempts Int        @default(0)
  lockedUntil    DateTime?
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, factor])
  @@map("auth_lockouts")
}

model OAuthAccount {
  id           String    @id @default(uuid())
  provider     String
  providerId   String
  accessToken  String?
  refreshToken String?
  tokenExpiry  DateTime?
  userId       String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@map("oauth_accounts")
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique // SHA-256 해시로 저장 (원문은 쿠키로만 전달)
  expires   DateTime
  rotatedAt DateTime? // 회전(재발급)된 시각. 값이 있으면 무효화된 토큰이며, 재제시 시 탈취 감지에 쓰인다.
  userId    String
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}
