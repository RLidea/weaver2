generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String                @id @default(uuid())
  username         String                @unique
  displayName      String                @unique
  profileImageUrl  String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  deletedAt        DateTime?
  lastLoginAt      DateTime?
  auths            Auth[]
  comments         Comment[]
  emailLogs        EmailLog[]
  pageViews        PageView[]
  posts            Post[]
  userSetting      UserSetting?
  userAgreements   UserTermsAgreement[]
  permissionGroups UserPermissionGroup[]
}

model UserSetting {
  id                          String   @id @default(uuid())
  userId                      String   @unique
  isMarketingConsentGiven     Boolean  @default(false)
  isNewsletterSubscribed      Boolean  @default(false)
  isEmailNotificationsEnabled Boolean  @default(true)
  isSmsNotificationsEnabled   Boolean  @default(false)
  isPushNotificationsEnabled  Boolean  @default(false)
  prefersDarkMode             Boolean  @default(false)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
  user                        User     @relation(fields: [userId], references: [id])
}

model Auth {
  id                      String            @id @default(uuid())
  email                   String            @unique
  password                String?
  passwordResetToken      String?
  resetTokenExpiry        DateTime?
  verificationToken       String?           @unique
  verificationTokenExpiry DateTime?
  isVerified              Boolean           @default(false)
  twoFactorEnabled        Boolean           @default(false)
  twoFactorSecret         String?
  userId                  String
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  user                    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthConnections        OAuthConnection[]
  refreshTokens           RefreshToken[]
}

model OAuthConnection {
  id           String    @id @default(uuid())
  provider     String
  providerId   String
  accessToken  String?
  refreshToken String?
  tokenExpiry  DateTime?
  authId       String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  auth         Auth      @relation(fields: [authId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expires   DateTime
  authId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  auth      Auth     @relation(fields: [authId], references: [id], onDelete: Cascade)
}

model TermsAndConditions {
  id             String               @id @default(uuid())
  version        Int                  @unique
  title          String
  content        String
  effectiveAt    DateTime
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  userAgreements UserTermsAgreement[]
}

model UserTermsAgreement {
  id                   String             @id @default(uuid())
  userId               String
  termsAndConditionsId String
  agreedAt             DateTime           @default(now())
  termsAndConditions   TermsAndConditions @relation(fields: [termsAndConditionsId], references: [id])
  user                 User               @relation(fields: [userId], references: [id])

  @@unique([userId, termsAndConditionsId])
}

model Board {
  id          String         @id @default(uuid())
  name        String         @unique
  description String?
  deletedAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  posts       Post[]
  categories  PostCategory[]
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Post {
  id                 String        @id @default(uuid())
  title              String
  content            String
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  boardId            String
  authorId           String
  categoryId         String?
  isPinned           Boolean       @default(false)
  isSecret           Boolean       @default(false)
  priority           Int           @default(0)
  status             PostStatus    @default(PUBLISHED)
  viewCount          Int           @default(0)
  requiredPermission String?
  deletedAt          DateTime?
  comments           Comment[]
  author             User          @relation(fields: [authorId], references: [id])
  board              Board         @relation(fields: [boardId], references: [id])
  category           PostCategory? @relation(fields: [categoryId], references: [id])

  @@index([boardId, status, isPinned, priority, viewCount], map: "post_list_idx")
  @@index([createdAt(sort: Desc), id], map: "post_cursor_idx")
  @@index([viewCount(sort: Desc), id], map: "post_viewcount_cursor_idx")
}

model Comment {
  id        String    @id @default(uuid())
  content   String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  postId    String
  authorId  String
  parentId  String?
  author    User      @relation(fields: [authorId], references: [id])
  post      Post      @relation(fields: [postId], references: [id])
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  children  Comment[] @relation("CommentReplies")

  @@index([postId, parentId, createdAt], map: "comment_list_idx")
}

model PostCategory {
  id          String   @id @default(uuid())
  name        String
  description String?
  color       String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  boardId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  posts       Post[]
  board       Board    @relation(fields: [boardId], references: [id])

  @@unique([boardId, name])
}

model PageView {
  id        String   @id @default(uuid())
  pageUrl   String   @db.VarChar(500)
  userId    String?
  ipAddress String?  @db.VarChar(45)
  referrer  String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([pageUrl, createdAt])
  @@index([userId, createdAt])
}

model MonthlyAnalyticsReport {
  id             String   @id @default(uuid())
  year           Int
  month          Int
  totalPageViews Int      @default(0)
  uniqueVisitors Int      @default(0)
  dailyAvgViews  Float    @default(0)
  peakDailyViews Int      @default(0)
  topPages       Json?
  trafficSources Json?
  dailyTrends    Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([year, month])
}

model EmailTemplate {
  id          String     @id @default(uuid())
  name        String     @unique
  subject     String
  htmlContent String
  textContent String?
  variables   Json?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  emailLogs   EmailLog[]
}

model EmailLog {
  id           String         @id @default(uuid())
  to           String
  from         String
  subject      String
  htmlContent  String
  textContent  String?
  templateId   String?
  status       EmailStatus    @default(PENDING)
  sentAt       DateTime?
  failedAt     DateTime?
  errorMessage String?
  metadata     Json?
  userId       String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  template     EmailTemplate? @relation(fields: [templateId], references: [id])
  user         User?          @relation(fields: [userId], references: [id])
}

model SecurityAuditReport {
  id                 String   @id @default(uuid())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  scanType           String   @default("pnpm_audit")
  scanDuration       Int?
  totalDependencies  Int
  vulnerabilityCount Json
  securityScore      Int
  rawAuditData       Json
  vulnerabilities    Json
  recommendations    Json?
  packageJsonHash    String?
  lockfileHash       String?
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  DELETED
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
  BOUNCED
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("SystemSettings")
}

model PermissionGroup {
  id                   String                           @id @default(uuid())
  name                 String                           @unique
  description          String?
  isSystem             Boolean                          @default(false)
  createdAt            DateTime                         @default(now())
  updatedAt            DateTime                         @updatedAt
  permissions          PermissionGroupPermission[]
  users                UserPermissionGroup[]
  allowedResourceRules ResourcePermissionAllowedGroup[]
  deniedResourceRules  ResourcePermissionDeniedGroup[]
}

model PermissionGroupPermission {
  id                String          @id @default(uuid())
  permissionGroupId String
  permission        String
  createdAt         DateTime        @default(now())
  permissionGroup   PermissionGroup @relation(fields: [permissionGroupId], references: [id], onDelete: Cascade)

  @@unique([permissionGroupId, permission])
}

model UserPermissionGroup {
  id                String          @id @default(uuid())
  userId            String
  permissionGroupId String
  createdAt         DateTime        @default(now())
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionGroup   PermissionGroup @relation(fields: [permissionGroupId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionGroupId])
}

model ResourcePermission {
  id             String                           @id @default(uuid())
  resourceType   String
  resourceId     String
  action         String
  allowAnonymous Boolean                          @default(false)
  createdAt      DateTime                         @default(now())
  updatedAt      DateTime                         @updatedAt
  allowedGroups  ResourcePermissionAllowedGroup[]
  deniedGroups   ResourcePermissionDeniedGroup[]

  @@unique([resourceType, resourceId, action])
}

model ResourcePermissionAllowedGroup {
  id                   String             @id @default(uuid())
  resourcePermissionId String
  permissionGroupId    String
  createdAt            DateTime           @default(now())
  resourcePermission   ResourcePermission @relation(fields: [resourcePermissionId], references: [id], onDelete: Cascade)
  permissionGroup      PermissionGroup    @relation(fields: [permissionGroupId], references: [id], onDelete: Cascade)

  @@unique([resourcePermissionId, permissionGroupId])
}

model ResourcePermissionDeniedGroup {
  id                   String             @id @default(uuid())
  resourcePermissionId String
  permissionGroupId    String
  createdAt            DateTime           @default(now())
  resourcePermission   ResourcePermission @relation(fields: [resourcePermissionId], references: [id], onDelete: Cascade)
  permissionGroup      PermissionGroup    @relation(fields: [permissionGroupId], references: [id], onDelete: Cascade)

  @@unique([resourcePermissionId, permissionGroupId])
}
