generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String               @id @default(uuid())
  email            String               @unique
  username         String               @unique
  displayName      String               @unique
  profileImageUrl  String?
  profileImagePath String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  deletedAt        DateTime?
  lastLoginAt      DateTime?
  localCredential      LocalCredential?
  oauthAccounts        OAuthAccount[]
  refreshTokens        RefreshToken[]
  twoFactorChallenges  TwoFactorChallenge[]
  emailChangeRequests  EmailChangeRequest[]
  comments            Comment[]
  emailLogs        EmailLog[]
  pageViews        PageView[]
  posts            Post[]
  reactions        PostReaction[]
  userSetting      UserSetting?
  userAgreements   UserTermsAgreement[]
  permissionGroups UserPermissionGroup[]
  files            PostFile[]
  notifications    Notification[]

  @@map("users")
}

model UserSetting {
  id                          String   @id @default(uuid())
  userId                      String   @unique
  isMarketingConsentGiven     Boolean  @default(false)
  isNewsletterSubscribed      Boolean  @default(false)
  isEmailNotificationsEnabled Boolean  @default(true)
  isSmsNotificationsEnabled   Boolean  @default(false)
  isPushNotificationsEnabled  Boolean  @default(false)
  prefersDarkMode             Boolean  @default(false)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
  user                        User     @relation(fields: [userId], references: [id])

  @@map("user_settings")
}

model LocalCredential {
  id                      String    @id @default(uuid())
  password                String
  passwordResetToken      String?   @unique
  resetTokenExpiry        DateTime?
  verificationToken       String?   @unique
  verificationTokenExpiry DateTime?
  isVerified              Boolean   @default(false)
  totpEnabled             Boolean   @default(false)
  totpSecret              String?
  emailOtpEnabled         Boolean   @default(false)
  failedAttempts          Int       @default(0)
  lockedUntil             DateTime?
  userId                  String    @unique
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("local_credentials")
}

model TwoFactorChallenge {
  id        String   @id @default(uuid())
  userId    String
  codeHash  String
  method    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, method])
  @@map("two_factor_challenges")
}

model EmailChangeRequest {
  id        String   @id @default(uuid())
  userId    String
  newEmail  String
  codeHash  String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_change_requests")
}

model OAuthAccount {
  id           String    @id @default(uuid())
  provider     String
  providerId   String
  accessToken  String?
  refreshToken String?
  tokenExpiry  DateTime?
  userId       String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@map("oauth_accounts")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expires   DateTime
  userId    String
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model TermsAndConditions {
  id             String               @id @default(uuid())
  version        Int                  @unique
  title          String
  content        String
  effectiveAt    DateTime
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  userAgreements UserTermsAgreement[]

  @@map("terms_and_conditions")
}

model UserTermsAgreement {
  id                   String             @id @default(uuid())
  userId               String
  termsAndConditionsId String
  agreedAt             DateTime           @default(now())
  termsAndConditions   TermsAndConditions @relation(fields: [termsAndConditionsId], references: [id])
  user                 User               @relation(fields: [userId], references: [id])

  @@unique([userId, termsAndConditionsId])
  @@map("user_terms_agreements")
}

model Board {
  id          String         @id @default(uuid())
  name        String         @unique
  description String?
  deletedAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  posts       Post[]
  categories  PostCategory[]

  @@map("boards")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Post {
  id                 String        @id @default(uuid())
  title              String
  content            String
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  boardId            String
  authorId           String
  categoryId         String?
  isPinned           Boolean       @default(false)
  isSecret           Boolean       @default(false)
  priority           Int           @default(0)
  status             PostStatus    @default(PUBLISHED)
  viewCount          Int           @default(0)
  requiredPermission String?
  deletedAt          DateTime?
  comments           Comment[]
  reactions          PostReaction[]
  files              PostFile[]
  author             User          @relation(fields: [authorId], references: [id])
  board              Board         @relation(fields: [boardId], references: [id])
  category           PostCategory? @relation(fields: [categoryId], references: [id])

  @@index([boardId, status, isPinned, priority, viewCount], map: "post_list_idx")
  @@index([createdAt(sort: Desc), id], map: "post_cursor_idx")
  @@index([viewCount(sort: Desc), id], map: "post_viewcount_cursor_idx")
  @@map("posts")
}

model Comment {
  id        String    @id @default(uuid())
  content   String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  postId    String
  authorId  String
  parentId  String?
  author    User      @relation(fields: [authorId], references: [id])
  post      Post      @relation(fields: [postId], references: [id])
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  children  Comment[] @relation("CommentReplies")

  @@index([postId, parentId, createdAt], map: "comment_list_idx")
  @@map("comments")
}

model PostCategory {
  id          String   @id @default(uuid())
  name        String
  description String?
  color       String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  boardId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  posts       Post[]
  board       Board    @relation(fields: [boardId], references: [id])

  @@unique([boardId, name])
  @@map("post_categories")
}

model PageView {
  id        String   @id @default(uuid())
  pageUrl   String   @db.VarChar(500)
  userId    String?
  ipAddress String?  @db.VarChar(45)
  referrer  String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([pageUrl, createdAt])
  @@index([userId, createdAt])
  @@map("page_views")
}

model MonthlyAnalyticsReport {
  id             String   @id @default(uuid())
  year           Int
  month          Int
  totalPageViews Int      @default(0)
  uniqueVisitors Int      @default(0)
  dailyAvgViews  Float    @default(0)
  peakDailyViews Int      @default(0)
  topPages       Json?
  trafficSources Json?
  dailyTrends    Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([year, month])
  @@map("monthly_analytics_reports")
}

model EmailTemplate {
  id          String     @id @default(uuid())
  name        String     @unique
  subject     String
  htmlContent String
  textContent String?
  variables   Json?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  emailLogs   EmailLog[]

  @@map("email_templates")
}

model EmailLog {
  id           String         @id @default(uuid())
  to           String
  from         String
  subject      String
  htmlContent  String
  textContent  String?
  templateId   String?
  status       EmailStatus    @default(PENDING)
  sentAt       DateTime?
  failedAt     DateTime?
  errorMessage String?
  metadata     Json?
  userId       String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  template     EmailTemplate? @relation(fields: [templateId], references: [id])
  user         User?          @relation(fields: [userId], references: [id])

  @@map("email_logs")
}

model SecurityAuditReport {
  id                 String   @id @default(uuid())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  scanType           String   @default("pnpm_audit")
  scanDuration       Int?
  totalDependencies  Int
  vulnerabilityCount Json
  securityScore      Int
  rawAuditData       Json
  vulnerabilities    Json
  recommendations    Json?
  packageJsonHash    String?
  lockfileHash       String?

  @@map("security_audit_reports")
}

model Emoji {
  id        String         @id @default(uuid())
  code      String         @unique
  name      String
  unicode   String?
  imageUrl  String?
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  reactions PostReaction[]

  @@map("emojis")
}

model PostReaction {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  postId    String
  userId    String
  emojiId   String
  post      Post     @relation(fields: [postId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  emoji     Emoji    @relation(fields: [emojiId], references: [id])

  @@unique([postId, userId, emojiId])
  @@index([postId])
  @@index([userId])
  @@map("post_reactions")
}

model PostFile {
  id            String    @id @default(uuid())
  originalName  String
  storedName    String    @unique
  mimeType      String
  size          Int
  path          String
  thumbnailPath String?
  postId        String?
  uploadedById  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  post          Post?     @relation(fields: [postId], references: [id], onDelete: SetNull)
  uploadedBy    User?     @relation(fields: [uploadedById], references: [id])

  @@index([uploadedById])
  @@index([postId])
  @@index([createdAt(sort: Desc), id], map: "post_file_cursor_idx")
  @@map("post_files")
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  DELETED
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@map("notifications")
}

enum NotificationType {
  COMMENT
  REPLY
  REACTION
  SYSTEM
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
  BOUNCED
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model PermissionGroup {
  id                   String                           @id @default(uuid())
  name                 String                           @unique
  description          String?
  isSystem             Boolean                          @default(false)
  createdAt            DateTime                         @default(now())
  updatedAt            DateTime                         @updatedAt
  permissions          PermissionGroupPermission[]
  users                UserPermissionGroup[]
  allowedResourceRules ResourcePermissionAllowedGroup[]
  deniedResourceRules  ResourcePermissionDeniedGroup[]

  @@map("permission_groups")
}

model PermissionGroupPermission {
  id                String          @id @default(uuid())
  permissionGroupId String
  permission        String
  createdAt         DateTime        @default(now())
  permissionGroup   PermissionGroup @relation(fields: [permissionGroupId], references: [id], onDelete: Cascade)

  @@unique([permissionGroupId, permission])
  @@map("permission_group_permissions")
}

model UserPermissionGroup {
  id                String          @id @default(uuid())
  userId            String
  permissionGroupId String
  createdAt         DateTime        @default(now())
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionGroup   PermissionGroup @relation(fields: [permissionGroupId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionGroupId])
  @@map("user_permission_groups")
}

model ResourcePermission {
  id             String                           @id @default(uuid())
  resourceType   String
  resourceId     String
  action         String
  allowAnonymous Boolean                          @default(false)
  createdAt      DateTime                         @default(now())
  updatedAt      DateTime                         @updatedAt
  allowedGroups  ResourcePermissionAllowedGroup[]
  deniedGroups   ResourcePermissionDeniedGroup[]

  @@unique([resourceType, resourceId, action])
  @@map("resource_permissions")
}

model ResourcePermissionAllowedGroup {
  id                   String             @id @default(uuid())
  resourcePermissionId String
  permissionGroupId    String
  createdAt            DateTime           @default(now())
  resourcePermission   ResourcePermission @relation(fields: [resourcePermissionId], references: [id], onDelete: Cascade)
  permissionGroup      PermissionGroup    @relation(fields: [permissionGroupId], references: [id], onDelete: Cascade)

  @@unique([resourcePermissionId, permissionGroupId])
  @@map("resource_permission_allowed_groups")
}

model ResourcePermissionDeniedGroup {
  id                   String             @id @default(uuid())
  resourcePermissionId String
  permissionGroupId    String
  createdAt            DateTime           @default(now())
  resourcePermission   ResourcePermission @relation(fields: [resourcePermissionId], references: [id], onDelete: Cascade)
  permissionGroup      PermissionGroup    @relation(fields: [permissionGroupId], references: [id], onDelete: Cascade)

  @@unique([resourcePermissionId, permissionGroupId])
  @@map("resource_permission_denied_groups")
}
