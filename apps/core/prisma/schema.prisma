generator client {
  provider = "prisma-client-js"
  // output   = "../src/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid())
  username        String    @unique
  displayName     String    @unique
  profileImageUrl String?
  role            Role      @default(USER)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  lastLoginAt     DateTime? // Add this line for active user tracking

  // Auth 관련 관계
  auths          Auth[]
  userAgreements UserTermsAgreement[]
  userSetting    UserSetting? // One-to-one relation
  posts          Post[] // Inverse relation for Post.author
  comments       Comment[] // Inverse relation for Comment.author
  emailLogs      EmailLog[] // Inverse relation for EmailLog.user
}

model UserSetting {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  isMarketingConsentGiven     Boolean @default(false)
  isNewsletterSubscribed      Boolean @default(false)
  isEmailNotificationsEnabled Boolean @default(true)
  isSmsNotificationsEnabled   Boolean @default(false)
  isPushNotificationsEnabled  Boolean @default(false)
  prefersDarkMode             Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  USER
  ADMIN
  MODERATOR
  DEVELOPER
}

model Auth {
  id                      String    @id @default(uuid())
  email                   String    @unique
  password                String? // 비밀번호는 OAuth 사용자에게는 null일 수 있음
  passwordResetToken      String? // 비밀번호 재설정 토큰
  resetTokenExpiry        DateTime? // 비밀번호 재설정 토큰 만료 시간
  verificationToken       String?   @unique // 이메일 인증 토큰
  verificationTokenExpiry DateTime? // 이메일 인증 토큰 만료 시간
  isVerified              Boolean   @default(false)
  twoFactorEnabled        Boolean   @default(false)
  twoFactorSecret         String? // 2FA 비밀키

  // 사용자 관계
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // OAuth 제공자 관계
  oauthConnections OAuthConnection[]

  // 세션 및 토큰 관계
  refreshTokens RefreshToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OAuthConnection {
  id           String    @id @default(uuid())
  provider     String // 'google', 'kakao', 'naver', 'facebook' 등
  providerId   String // 제공자에서의 사용자 ID
  accessToken  String? // OAuth 액세스 토큰
  refreshToken String? // OAuth 리프레시 토큰
  tokenExpiry  DateTime?

  // Auth 관계
  authId String
  auth   Auth   @relation(fields: [authId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerId])
}

model RefreshToken {
  id      String   @id @default(uuid())
  token   String   @unique
  expires DateTime

  // Auth 관계
  authId String
  auth   Auth   @relation(fields: [authId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TermsAndConditions {
  id          String   @id @default(uuid())
  version     Int      @unique
  title       String
  content     String
  effectiveAt DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userAgreements UserTermsAgreement[]
}

model UserTermsAgreement {
  id                   String             @id @default(uuid())
  userId               String
  user                 User               @relation(fields: [userId], references: [id])
  termsAndConditionsId String
  termsAndConditions   TermsAndConditions @relation(fields: [termsAndConditionsId], references: [id])
  agreedAt             DateTime           @default(now())

  @@unique([userId, termsAndConditionsId])
}

model Board {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  posts       Post[]
}

model Post {
  id        String   @id @default(uuid())
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  boardId String
  board   Board  @relation(fields: [boardId], references: [id])

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  comments Comment[]
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  postId String
  post   Post   @relation(fields: [postId], references: [id])

  authorId String
  author   User   @relation(fields: [authorId], references: [id])
}

model EmailTemplate {
  id          String   @id @default(uuid())
  name        String   @unique // "welcome", "password-reset", "email-verification"
  subject     String
  htmlContent String
  textContent String?
  variables   Json?    // 템플릿 변수 정의 (예: ["userName", "verificationLink"])
  isActive    Boolean  @default(true)
  
  emailLogs   EmailLog[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("email_templates")
}

model EmailLog {
  id          String      @id @default(uuid())
  to          String
  from        String
  subject     String
  htmlContent String
  textContent String?
  templateId  String?
  status      EmailStatus @default(PENDING)
  sentAt      DateTime?
  failedAt    DateTime?
  errorMessage String?
  metadata    Json?       // 추가 메타데이터 (템플릿 변수값 등)
  
  template    EmailTemplate? @relation(fields: [templateId], references: [id])
  user        User?          @relation(fields: [userId], references: [id])
  userId      String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("email_logs")
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
  BOUNCED
}
