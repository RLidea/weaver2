{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@weaver2/common": [
        "libs/common/src"
      ],
      "@weaver2/common/*": [
        "libs/common/src/*"
      ],
      "@weaver2/email": [
        "libs/email/src"
      ],
      "@weaver2/email/*": [
        "libs/email/src/*"
      ],
      "@weaver2/pagination": [
        "libs/pagination/src"
      ],
      "@weaver2/pagination/*": [
        "libs/pagination/src/*"
      ],
      "@weaver2/prisma": [
        "libs/prisma/src"
      ],
      "@weaver2/prisma/*": [
        "libs/prisma/src/*"
      ],
      "@weaver2/upload": [
        "libs/upload/src"
      ],
      "@weaver2/upload/*": [
        "libs/upload/src/*"
      ],
      "@weaver2/shared": [
        "libs/shared/src"
      ],
      "@weaver2/shared/*": [
        "libs/shared/src/*"
      ]
    }
  },
  "include": [
    "apps/**/*.ts",
    "libs/**/*.ts",
    "apps/core/src/types/**/*.d.ts"
  ]
}