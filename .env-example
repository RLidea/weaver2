# COMMON
APP_NAME=weaver2
PORT=3000
NODE_ENV=development
ORIGIN_URL=localhost:3000
CLIENT_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# DATABASE
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/<db>

# Docker (used by docker-compose)
DOCKER_APP_TARGET=core          # target app to build (e.g., core, admin)
DB_USER=weaver
DB_PASSWORD=weaver1234
DB_NAME=weaver2
DB_PORT=5432

# TOKEN
JWT_SECRET=
JWT_EXPIRES_IN=1h

# EMAIL
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Locale and Timezone
APP_LOCALE=ko-KR
APP_TIMEZONE=Asia/Seoul

# Permission Cache
PERMISSION_CACHE_STRATEGY=memory  # memory | none
PERMISSION_CACHE_TTL=300          # seconds
PERMISSION_CACHE_MAX_SIZE=1000    # max cached users
