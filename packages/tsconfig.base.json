{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowJs": false,
    "incremental": false,
    "baseUrl": ".",
    "paths": {
      "@weaver2/shared": ["../libs/shared/src"],
      "@weaver2/shared/*": ["../libs/shared/src/*"]
    }
  }
}
