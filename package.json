{
  "name": "weaver2",
  "version": "0.0.1",
  "description": "",
  "author": "Centell",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "init": "sh scripts/init.sh",
    "---------------------------COMMON---------------------------": "",
    "dev": "sh scripts/run-project.sh dev",
    "debug": "sh scripts/run-project.sh debug",
    "start": "sh scripts/run-project.sh start",
    "build": "sh scripts/run-project.sh build",
    "---------------------------WEB---------------------------": "",
    "dev:web": "pnpm --filter core-frontend dev",
    "build:web": "pnpm --filter core-frontend build",
    "storybook:web": "pnpm --filter core-frontend storybook",
    "---------------------------CORE---------------------------": "",
    "dev:core": "nest start core-backend --watch",
    "debug:core": "nest start core-backend --debug --watch",
    "prod:core": "node dist/apps/core-backend/main",
    "build:core": "nest build core-backend",
    "---------------------------LANES---------------------------": "",
    "lane:brief": "bash scripts/lane.sh brief",
    "lane:new": "bash scripts/lane.sh new",
    "lane:prep": "bash scripts/lane.sh prep",
    "lane:ls": "bash scripts/lane.sh ls",
    "lane:e2e": "bash scripts/lane.sh e2e",
    "lane:show": "bash scripts/lane.sh show",
    "lane:back": "bash scripts/lane.sh back",
    "lane:land": "bash scripts/lane.sh land",
    "lane:rm": "bash scripts/lane.sh rm",
    "---------------------------BUILD---------------------------": "",
    "typecheck": "pnpm typecheck:core && pnpm typecheck:web",
    "typecheck:core": "tsc --noEmit -p apps/core-backend/tsconfig.app.json",
    "typecheck:web": "pnpm --filter core-frontend typecheck",
    "test": "sh scripts/run-test.sh test",
    "test:core": "jest --config apps/core-backend/jest.config.js",
    "test:watch": "sh scripts/run-test.sh watch",
    "test:cov": "sh scripts/run-test.sh cov",
    "test:e2e": "sh scripts/run-test.sh e2e",
    "test:integration": "sh scripts/run-test.sh integration",
    "test:integration:run": "jest --config apps/core-backend/test/jest-integration.json --no-coverage",
    "test:debug": "sh scripts/run-test.sh debug",
    "gen:barrel:common": "tsx scripts/generate-barrel.ts ../libs/common/src",
    "---------------------------DATABASE---------------------------": "",
    "db:generate": "pnpm db:core:generate",
    "db:migrate": "pnpm db:core:migrate",
    "db:reset": "pnpm db:core:reset",
    "db:seed": "pnpm db:core:seed",
    "db:deploy": "pnpm db:core:deploy",
    "db:core:deploy": "dotenv -e apps/core-backend/.env -- pnpm prisma migrate deploy --schema=apps/core-backend/prisma/schema",
    "db:core:generate": "dotenv -e apps/core-backend/.env -- pnpm prisma generate --schema=apps/core-backend/prisma/schema",
    "db:core:migrate": "dotenv -e apps/core-backend/.env -- npx prisma migrate dev --schema=apps/core-backend/prisma/schema",
    "db:core:reset": "dotenv -e apps/core-backend/.env -- pnpm prisma migrate reset --schema=apps/core-backend/prisma/schema",
    "db:core:seed": "dotenv -e apps/core-backend/.env -- ts-node -r tsconfig-paths/register --transpile-only apps/core-backend/prisma/seed/seed.ts",
    "---------------------------OPENAPI---------------------------": "",
    "openapi:metadata": "ts-node -r tsconfig-paths/register --transpile-only apps/core-backend/scripts/generate-metadata.ts",
    "openapi:generate": "pnpm openapi:metadata && ts-node -r tsconfig-paths/register --transpile-only apps/core-backend/scripts/generate-openapi.ts",
    "openapi:types": "pnpm openapi:generate && pnpm --filter @weaver2/api-client gen:api-types",
    "---------------------------Security---------------------------": "",
    "audit:json": "pnpm audit --json --no-optional",
    "---------------------------OTHERs---------------------------": "",
    "format": "prettier --write \"apps/core-backend/**/*.ts\" \"libs/**/*.ts\"",
    "lint": "eslint \"{src,apps/core-backend,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps/core-backend,libs,test}/**/*.ts\" && pnpm --filter core-frontend lint",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/s3-request-presigner": "^3.1131.0",
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.3",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "6.12.0",
    "bcrypt": "^6.0.0",
    "chalk": "^5.6.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "cookie-parser": "^1.4.7",
    "csrf": "^3.1.0",
    "csrf-csrf": "^4.0.3",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "multer": "^2.3.0",
    "nest-winston": "^1.10.2",
    "nodemailer": "^10.0.10",
    "otplib": "^13.5.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.4",
    "web-push": "^3.6.7",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.3",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.2",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "@types/web-push": "^3.6.4",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "prettier": "^3.9.6",
    "prisma": "6.12.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "prisma": {
    "seed": "ts-node -r tsconfig-paths/register --transpile-only apps/core-backend/prisma/seed/seed.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@weaver2/common(|/.*)$": "<rootDir>/libs/common/src/$1",
      "^@weaver2/email(|/.*)$": "<rootDir>/libs/email/src/$1",
      "^@weaver2/pagination(|/.*)$": "<rootDir>/libs/pagination/src/$1",
      "^@weaver2/prisma(|/.*)$": "<rootDir>/libs/prisma/src/$1",
      "^@weaver2/shared(|/.*)$": "<rootDir>/libs/shared/src/$1",
      "^@weaver2/upload(|/.*)$": "<rootDir>/libs/upload/src/$1"
    }
  }
}
