{
  "name": "weaver2",
  "version": "0.0.1",
  "description": "",
  "author": "Centell",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "---------------------------COMMON---------------------------": "",
    "dev": "sh scripts/run-project.sh dev",
    "debug": "sh scripts/run-project.sh debug",
    "start": "sh scripts/run-project.sh start",
    "build": "sh scripts/run-project.sh build",
    "---------------------------CORE---------------------------": "",
    "core:dev": "nest start ypet --watch",
    "core:debug": "nest start ypet --debug --watch",
    "core:prod": "node dist/apps/core/main",
    "core:build": "nest build core",
    "---------------------------BUILD---------------------------": "",
    "test": "sh scripts/run-test.sh test",
    "test:watch": "sh scripts/run-test.sh watch",
    "test:cov": "sh scripts/run-test.sh cov",
    "test:e2e": "sh scripts/run-test.sh e2e",
    "test:integration": "sh scripts/run-test.sh integration",
    "test:debug": "sh scripts/run-test.sh debug",
    "gen:barrel:common": "tsx scripts/generate-barrel.ts ../libs/common/src",
    "---------------------------DB---------------------------": "",
    "db:generate": "pnpm prisma generate --schema=libs/prisma/prisma/schema.prisma",
    "db:migrate": "npx prisma migrate dev --schema=libs/prisma/prisma/schema.prisma",
    "db:reset": "pnpm prisma migrate reset --schema=libs/prisma/prisma/schema.prisma",
    "db:seed": "ts-node --transpile-only libs/prisma/src/seed.ts",
    "---------------------------OTHERs---------------------------": "",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "postinstall": "npx husky init",
    "prepare": "husky"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.3",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "6.9.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "helmet": "^8.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.7",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "prisma": "6.9.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@weaver2/common(|/.*)$": "<rootDir>/libs/common/src/$1",
      "^@weaver2/prisma(|/.*)$": "<rootDir>/libs/prisma/src/$1"
    }
  }
}
